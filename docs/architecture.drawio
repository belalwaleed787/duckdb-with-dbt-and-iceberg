parent="1" source="star-ft-2" target="star-dd-0"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="star-r2" value="" style="edgeStyle=entityRelationEdgeStyle;html=1;rounded=0;strokeColor=#8A6508;strokeWidth=1.2;startArrow=ERmany;startFill=0;endArrow=ERmandOne;endFill=0;startSize=10;endSize=10;" edge="1" parent="1" source="star-ft-3" target="star-dt-0"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="star-r3" value="" style="edgeStyle=entityRelationEdgeStyle;html=1;rounded=0;strokeColor=#8A6508;strokeWidth=1.2;startArrow=ERmany;startFill=0;endArrow=ERmandOne;endFill=0;startSize=10;endSize=10;" edge="1" parent="1" source="star-ft-4" target="star-dl-0"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="star-r4" value="" style="edgeStyle=entityRelationEdgeStyle;html=1;rounded=0;strokeColor=#8A6508;strokeWidth=1.2;startArrow=ERmany;startFill=0;endArrow=ERmandOne;endFill=0;startSize=10;endSize=10;" edge="1" parent="1" source="star-ft-5" target="star-dl-0"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="star-r5" value="" style="edgeStyle=entityRelationEdgeStyle;html=1;rounded=0;strokeColor=#8A6508;strokeWidth=1.2;startArrow=ERmany;startFill=0;endArrow=ERmandOne;endFill=0;startSize=10;endSize=10;" edge="1" parent="1" source="star-ft-6" target="star-dv-0"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="star-r6" value="" style="edgeStyle=entityRelationEdgeStyle;html=1;rounded=0;strokeColor=#8A6508;strokeWidth=1.2;startArrow=ERmany;startFill=0;endArrow=ERmandOne;endFill=0;startSize=10;endSize=10;" edge="1" parent="1" source="star-ft-7" target="star-dr-0"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="star-r7" value="" style="edgeStyle=entityRelationEdgeStyle;html=1;rounded=0;strokeColor=#8A6508;strokeWidth=1.2;startArrow=ERmany;startFill=0;endArrow=ERmandOne;endFill=0;startSize=10;endSize=10;" edge="1" parent="1" source="star-ft-8" target="star-dp-0"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="star-r8" value="" style="edgeStyle=entityRelationEdgeStyle;html=1;rounded=0;strokeColor=#8A6508;strokeWidth=1.2;startArrow=ERmany;startFill=0;endArrow=ERmandOne;endFill=0;startSize=10;endSize=10;" edge="1" parent="1" source="star-fs-0" target="star-dd-0"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="star-r9" value="" style="edgeStyle=entityRelationEdgeStyle;html=1;rounded=0;strokeColor=#8A6508;strokeWidth=1.2;startArrow=ERmany;startFill=0;endArrow=ERmandOne;endFill=0;startSize=10;endSize=10;" edge="1" parent="1" source="star-fs-1" target="star-dl-0"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="star-n1" value='&lt;b style="font-size:12px"&gt;fact_trips&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#475569"&gt;trip_id = yyyymm of the source file × 10&lt;sup&gt;8&lt;/sup&gt; + row number in that file (e.g. 20230100000123): stable across re-runs and points back to the exact raw row. Partitioned by month(pickup_at), loaded incrementally per source file. Money columns are DECIMAL(10,2).&lt;/span&gt;' style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#FFF8DB;strokeColor=#D6B656;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=10;fontSize=12;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="760" y="610" width="380" height="120" as="geometry"/></mxCell><mxCell id="star-n2" value='&lt;b style="font-size:12px"&gt;fact_daily_zone_summary&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#475569"&gt;grain: pickup day × pickup zone. Rebuilt every run by aggregating fact_trips, for dashboards that do not need trip-level detail.&lt;/span&gt;' style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#FFF8DB;strokeColor=#D6B656;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=10;fontSize=12;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="40" y="640" width="300" height="80" as="geometry"/></mxCell><mxCell id="star-n3" value='&lt;b style="font-size:12px"&gt;Dimensions&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#475569"&gt;Rebuilt every run. Code dimensions take the TLC data dictionary CSVs plus any unknown code that appears in silver, so every fact key resolves.&lt;/span&gt;' style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#FFF8DB;strokeColor=#D6B656;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=10;fontSize=12;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="1240" y="610" width="230" height="120" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="run" name="4 · One run, step by step"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1680" math="0" shadow="0" adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="run-title" value="Inside one run: container start-up and the Iceberg materializations" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=22;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="20" y="14" width="1400" height="34" as="geometry"/></mxCell><mxCell id="run-sub" value="macros/iceberg/iceberg_table.sql and iceberg_incremental.sql replace dbt-duckdb's built-in materializations, which do not work against Glue (explicit table location, no RENAME, no DROP … PURGE)." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="20" y="50" width="1560" height="30" as="geometry"/></mxCell><mxCell id="run-q0" value='&lt;b style="font-size:13px"&gt;Start&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#475569"&gt;ECS RunTask (run_on_ecs.ps1) or docker run&lt;/span&gt;' style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="210" height="100" as="geometry"/></mxCell><mxCell id="run-q1" value='&lt;b&gt;&lt;span style="font-family:Consolas,Menlo,monospace;font-size:12px"&gt;entrypoint.sh&lt;/span&gt;&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#475569"&gt;memory limit from cgroup / ECS task metadata → DUCKDB_MEMORY_LIMIT = 60%&lt;/span&gt;' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=12;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="290" y="100" width="210" height="100" as="geometry"/></mxCell><mxCell id="run-qe1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=1.5;fontColor=#1F2937;fontSize=12;labelBackgroundColor=default;endArrow=block;endFill=1;endSize=6;jumpStyle=arc;jumpSize=8;" edge="1" parent="1" source="run-q0" target="run-q1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="run-q2" value='&lt;b style="font-size:13px"&gt;Start sampler&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#475569"&gt;peak memory every 5 s; CPU and network counters&lt;/span&gt;' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=12;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="540" y="100" width="210" height="100" as="geometry"/></mxCell><mxCell id="run-qe2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=1.5;fontColor=#1F2937;fontSize=12;labelBackgroundColor=default;endArrow=block;endFill=1;endSize=6;jumpStyle=arc;jumpSize=8;" edge="1" parent="1" source="run-q1" target="run-q2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="run-q3" value='&lt;b&gt;&lt;span style="font-family:Consolas,Menlo,monospace;font-size:12px"&gt;dbt build&lt;/span&gt;&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#475569"&gt;profiles.yml: ATTACH Glue as lakehouse · S3 secret from credential chain · DBT_THREADS = 4&lt;/span&gt;' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=12;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="790" y="100" width="210" height="100" as="geometry"/></mxCell><mxCell id="run-qe3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=1.5;fontColor=#1F2937;fontSize=12;labelBackgroundColor=default;endArrow=block;endFill=1;endSize=6;jumpStyle=arc;jumpSize=8;" edge="1" parent="1" source="run-q2" target="run-q3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="run-q4" value='&lt;b&gt;&lt;span style="font-family:Consolas,Menlo,monospace;font-size:12px"&gt;run_summary&lt;/span&gt;&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#475569"&gt;one JSON log line: exit code, elapsed, CPU, peak memory, network&lt;/span&gt;' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=12;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="1040" y="100" width="210" height="100" as="geometry"/></mxCell><mxCell id="run-qe4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=1.5;fontColor=#1F2937;fontSize=12;labelBackgroundColor=default;endArrow=block;endFill=1;endSize=6;jumpStyle=arc;jumpSize=8;" edge="1" parent="1" source="run-q3" target="run-q4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="run-q5" value="&lt;b style=&quot;font-size:13px&quot;&gt;Exit&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#475569&quot;&gt;with dbt's exit code (run_on_ecs.ps1 returns it)&lt;/span&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="1290" y="100" width="210" height="100" as="geometry"/></mxCell><mxCell id="run-qe5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=1.5;fontColor=#1F2937;fontSize=12;labelBackgroundColor=default;endArrow=block;endFill=1;endSize=6;jumpStyle=arc;jumpSize=8;" edge="1" parent="1" source="run-q4" target="run-q5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="run-flow" value='&lt;b style="font-size:14px"&gt;For each model, in DAG order (up to DBT_THREADS = 4 at once); its tests run right after it&lt;/b&gt;' style="swimlane;startSize=34;html=1;whiteSpace=wrap;rounded=1;arcSize=1;fillColor=#E2E8F0;swimlaneFillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#0F172A;align=left;spacingLeft=12;collapsible=0;" vertex="1" parent="1"><mxGeometry x="40" y="250" width="1170" height="1390" as="geometry"/></mxCell><mxCell id="run-q3f" value="for each model" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#64748B;strokeWidth=1.5;fontColor=#1F2937;fontSize=12;labelBackgroundColor=default;endArrow=block;endFill=1;endSize=6;jumpStyle=arc;jumpSize=8;dashed=1;dashPattern=6 4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="run-q3" target="run-flow"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="run-S" value='&lt;b style="font-size:12px"&gt;Next model&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#475569"&gt;compiled SQL ready&lt;/span&gt;' style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;fontColor=#1F2937;" vertex="1" parent="run-flow"><mxGeometry x="490" y="64" width="190" height="56" as="geometry"/></mxCell><mxCell id="run-D1" value="Table exists and no --full-refresh?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;fontColor=#1F2937;spacing=12;" vertex="1" parent="run-flow"><mxGeometry x="490" y="182" width="190" height="90" as="geometry"/></mxCell><mxCell id="run-D2" value="Column list changed?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;fontColor=#1F2937;spacing=12;" vertex="1" parent="run-flow"><mxGeometry x="490" y="317" width="190" height="90" as="geometry"/></mxCell><mxCell id="run-D3" value="Materialization?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;fontColor=#1F2937;spacing=12;" vertex="1" parent="run-flow"><mxGeometry x="720" y="317" width="190" height="90" as="geometry"/></mxCell><mxCell id="run-F" value='&lt;b&gt;Fail the model&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#475569"&gt;“run dbt build --full-refresh --select &amp;lt;model&amp;gt;”&lt;/span&gt;' style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=12;fontColor=#1F2937;" vertex="1" parent="run-flow"><mxGeometry x="720" y="597" width="190" height="70" as="geometry"/></mxCell><mxCell id="run-D4" value="Materialization?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;fontColor=#1F2937;spacing=12;" vertex="1" parent="run-flow"><mxGeometry x="490" y="452" width="190" height="90" as="geometry"/></mxCell><mxCell id="run-T1" value='&lt;b&gt;DELETE&lt;/b&gt; all rows + &lt;b&gt;INSERT&lt;/b&gt; the new result&lt;br&gt;&lt;span style="font-size:11px;color:#475569"&gt;one transaction&lt;/span&gt;' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FBF1CF;strokeColor=#B8860B;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=12;fontColor=#1F2937;" vertex="1" parent="run-flow"><mxGeometry x="490" y="600" width="190" height="64" as="geometry"/></mxCell><mxCell id="run-I1" value='&lt;b&gt;Find pending files&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#475569"&gt;bronze: landing name + last-modified not loaded yet; silver/gold: (_source_file, _batch_id) not seen yet&lt;/span&gt;' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=12;fontColor=#1F2937;" vertex="1" parent="run-flow"><mxGeometry x="30" y="457" width="190" height="80" as="geometry"/></mxCell><mxCell id="run-I2" value='&lt;b&gt;Stage new rows&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#475569"&gt;table in the local DuckDB file (/tmp)&lt;/span&gt;' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=12;fontColor=#1F2937;" vertex="1" parent="run-flow"><mxGeometry x="30" y="600" width="190" height="64" as="geometry"/></mxCell><mxCell id="run-D5" value="Any new rows?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;fontColor=#1F2937;spacing=12;" vertex="1" parent="run-flow"><mxGeometry x="30" y="722" width="190" height="90" as="geometry"/></mxCell><mxCell id="run-N0" value='&lt;b&gt;Nothing new&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#475569"&gt;no new snapshot; staging dropped, tests still run&lt;/span&gt;' style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;fontSize=12;fontColor=#1F2937;" vertex="1" parent="run-flow"><mxGeometry x="260" y="735" width="190" height="64" as="geometry"/></mxCell><mxCell id="run-I3" value='&lt;b&gt;DELETE&lt;/b&gt; rows whose _source_file was staged + &lt;b&gt;INSERT&lt;/b&gt; staged rows&lt;br&gt;&lt;span style="font-size:11px;color:#475569"&gt;one transaction&lt;/span&gt;' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=12;fontColor=#1F2937;" vertex="1" parent="run-flow"><mxGeometry x="30" y="864" width="190" height="76" as="geometry"/></mxCell><mxCell id="run-R1" value='&lt;b&gt;Stage all rows&lt;/b&gt; in local DuckDB&lt;br&gt;&lt;span style="font-size:11px;color:#475569"&gt;skipped when there is no table yet&lt;/span&gt;' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=12;fontColor=#1F2937;" vertex="1" parent="run-flow"><mxGeometry x="950" y="195" width="190" height="64" as="geometry"/></mxCell><mxCell id="run-R2" value='&lt;b&gt;DROP&lt;/b&gt; the old table in Glue&lt;br&gt;&lt;span style="font-size:11px;color:#475569"&gt;only after staging succeeded&lt;/span&gt;' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=12;fontColor=#1F2937;" vertex="1" parent="run-flow"><mxGeometry x="950" y="330" width="190" height="64" as="geometry"/></mxCell><mxCell id="run-R3" value='&lt;b&gt;Purge the table folder&lt;/b&gt; in S3&lt;br&gt;&lt;span style="font-size:11px;color:#475569"&gt;iceberg_purge_location(), allow-list only&lt;/span&gt;' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=12;fontColor=#1F2937;" vertex="1" parent="run-flow"><mxGeometry x="950" y="465" width="190" height="64" as="geometry"/></mxCell><mxCell id="run-R4" value="&lt;b&gt;CREATE TABLE … PARTITIONED BY … WITH (location) AS SELECT&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=12;fontColor=#1F2937;" vertex="1" parent="run-flow"><mxGeometry x="950" y="597" width="190" height="70" as="geometry"/></mxCell><mxCell id="run-C1" value='&lt;b&gt;COMMIT&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#475569"&gt;one Iceberg snapshot; Glue now points at the new metadata.json&lt;/span&gt;' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=12;fontColor=#1F2937;" vertex="1" parent="run-flow"><mxGeometry x="490" y="1002" width="190" height="70" as="geometry"/></mxCell><mxCell id="run-C2" value="&lt;b&gt;Drop staging table&lt;/b&gt;, run the model's tests" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=12;fontColor=#1F2937;" vertex="1" parent="run-flow"><mxGeometry x="490" y="1140" width="190" height="64" as="geometry"/></mxCell><mxCell id="run-E" value='&lt;b style="font-size:12px"&gt;Model done&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#475569"&gt;next model in the DAG&lt;/span&gt;' style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;fontColor=#1F2937;" vertex="1" parent="run-flow"><mxGeometry x="490" y="1279" width="190" height="56" as="geometry"/></mxCell><mxCell id="run-f0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=1.5;fontColor=#1F2937;fontSize=12;labelBackgroundColor=default;endArrow=block;endFill=1;endSize=6;jumpStyle=arc;jumpSize=8;" edge="1" parent="run-flow" source="run-S" target="run-D1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="run-f1" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=1.5;fontColor=#2D7600;fontSize=12;labelBackgroundColor=default;endArrow=block;endFill=1;endSize=6;jumpStyle=arc;jumpSize=8;fontStyle=1;" edge="1" parent="run-flow" source="run-D1" target="run-D2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="run-f2" value="no: first run or --full-refresh" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=1.5;fontColor=#B20000;fontSize=12;labelBackgroundColor=default;endArrow=block;endFill=1;endSize=6;jumpStyle=arc;jumpSize=8;fontStyle=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="run-flow" source="run-D1" target="run-R1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="run-f3" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=1.5;fontColor=#B20000;fontSize=12;labelBackgroundColor=default;endArrow=block;endFill=1;endSize=6;jumpStyle=arc;jumpSize=8;fontStyle=1;" edge="1" parent="run-flow" source="run-D2" target="run-D4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="run-f4" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=1.5;fontColor=#2D7600;fontSize=12;labelBackgroundColor=default;endArrow=block;endFill=1;endSize=6;jumpStyle=arc;jumpSize=8;fontStyle=1;" edge="1" parent="run-flow" source="run-D2" target="run-D3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="run-f5" value="incremental" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=1.5;fontColor=#1F2937;fontSize=12;labelBackgroundColor=default;endArrow=block;endFill=1;endSize=6;jumpStyle=arc;jumpSize=8;" edge="1" parent="run-flow" source="run-D3" target="run-F"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="run-f6" value="table" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=1.5;fontColor=#1F2937;fontSize=12;labelBackgroundColor=default;endArrow=block;endFill=1;endSize=6;jumpStyle=arc;jumpSize=8;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.8;entryDx=0;entryDy=0;" edge="1" parent="run-flow" source="run-D3" target="run-R1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="run-f7" value="iceberg_table" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=1.5;fontColor=#1F2937;fontSize=12;labelBackgroundColor=default;endArrow=block;endFill=1;endSize=6;jumpStyle=arc;jumpSize=8;" edge="1" parent="run-flow" source="run-D4" target="run-T1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="run-f8" value="iceberg_incremental" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=1.5;fontColor=#1F2937;fontSize=12;labelBackgroundColor=default;endArrow=block;endFill=1;endSize=6;jumpStyle=arc;jumpSize=8;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="run-flow" source="run-D4" target="run-I1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="run-f9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=1.5;fontColor=#1F2937;fontSize=12;labelBackgroundColor=default;endArrow=block;endFill=1;endSize=6;jumpStyle=arc;jumpSize=8;" edge="1" parent="run-flow" source="run-I1" target="run-I2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="run-f10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=1.5;fontColor=#1F2937;fontSize=12;labelBackgroundColor=default;endArrow=block;endFill=1;endSize=6;jumpStyle=arc;jumpSize=8;" edge="1" parent="run-flow" source="run-I2" target="run-D5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="run-f11" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=1.5;fontColor=#2D7600;fontSize=12;labelBackgroundColor=default;endArrow=block;endFill=1;endSize=6;jumpStyle=arc;jumpSize=8;fontStyle=1;" edge="1" parent="run-flow" source="run-D5" target="run-I3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="run-f12" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=1.5;fontColor=#B20000;fontSize=12;labelBackgroundColor=default;endArrow=block;endFill=1;endSize=6;jumpStyle=arc;jumpSize=8;fontStyle=1;" edge="1" parent="run-flow" source="run-D5" target="run-N0"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="run-f13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=1.5;fontColor=#1F2937;fontSize=12;labelBackgroundColor=default;endArrow=block;endFill=1;endSize=6;jumpStyle=arc;jumpSize=8;" edge="1" parent="run-flow" source="run-R1" target="run-R2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="run-f14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=1.5;fontColor=#1F2937;fontSize=12;labelBackgroundColor=default;endArrow=block;endFill=1;endSize=6;jumpStyle=arc;jumpSize=8;" edge="1" parent="run-flow" source="run-R2" target="run-R3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="run-f15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=1.5;fontColor=#1F2937;fontSize=12;labelBackgroundColor=default;endArrow=block;endFill=1;endSize=6;jumpStyle=arc;jumpSize=8;" edge="1" parent="run-flow" source="run-R3" target="run-R4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="run-f16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=1.5;fontColor=#1F2937;fontSize=12;labelBackgroundColor=default;endArrow=block;endFill=1;endSize=6;jumpStyle=arc;jumpSize=8;" edge="1" parent="run-flow" source="run-T1" target="run-C1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="run-f17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=1.5;fontColor=#1F2937;fontSize=12;labelBackgroundColor=default;endArrow=block;endFill=1;endSize=6;jumpStyle=arc;jumpSize=8;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="run-flow" source="run-I3" target="run-C1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="run-f18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=1.5;fontColor=#1F2937;fontSize=12;labelBackgroundColor=default;endArrow=block;endFill=1;endSize=6;jumpStyle=arc;jumpSize=8;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="run-flow" source="run-R4" target="run-C1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="run-f19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=1.5;fontColor=#1F2937;fontSize=12;labelBackgroundColor=default;endArrow=block;endFill=1;endSize=6;jumpStyle=arc;jumpSize=8;" edge="1" parent="run-flow" source="run-C1" target="run-C2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="run-f20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=1.5;fontColor=#1F2937;fontSize=12;labelBackgroundColor=default;endArrow=block;endFill=1;endSize=6;jumpStyle=arc;jumpSize=8;" edge="1" parent="run-flow" source="run-C2" target="run-E"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="run-why" value='&lt;b style="font-size:13px"&gt;Why it is safe&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#475569"&gt;• Every write is one transaction, so one atomic Iceberg commit. Athena never sees an empty or half-written table, and the previous snapshot stays available.&lt;br&gt;&lt;br&gt;• A rebuild drops the old table only after the new rows are computed into a local staging table: a broken model never leaves a table missing.&lt;br&gt;&lt;br&gt;• The purge plugin refuses any location outside bronze-duck/, silver-duck/ and gold-duck/ (dev/… for the dev target).&lt;br&gt;&lt;br&gt;• Deletes are written as positional delete files (merge-on-read) and every run adds a snapshot: enable Glue table optimizers or run Athena OPTIMIZE / VACUUM.&lt;/span&gt;' style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#FFF8DB;strokeColor=#D6B656;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=10;fontSize=12;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="1240" y="250" width="330" height="330" as="geometry"/></mxCell><mxCell id="run-lgp" value='&lt;b style="font-size:13px"&gt;Colors&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#475569"&gt;&lt;span style="color:#6C8EBF"&gt;■&lt;/span&gt; incremental path &amp;nbsp; &lt;span style="color:#B8860B"&gt;■&lt;/span&gt; table path&lt;br&gt;&lt;span style="color:#9673A6"&gt;■&lt;/span&gt; rebuild path &amp;nbsp; &lt;span style="color:#82B366"&gt;■&lt;/span&gt; commit / done&lt;br&gt;&lt;span style="color:#D6B656"&gt;◆&lt;/span&gt; decision &amp;nbsp; &lt;span style="color:#B85450"&gt;■&lt;/span&gt; failure&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1240" y="600" width="330" height="84" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
