<mxfile host="Electron" type="device"><diagram id="aws" name="1 · AWS deployment"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1940" pageHeight="1230" math="0" shadow="0" adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="aws-title" value="NYC taxi lakehouse on AWS: deployment architecture" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=22;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="20" y="14" width="1400" height="34" as="geometry"/></mxCell><mxCell id="aws-sub" value="One container image (Python 3.12 · dbt-core 1.12.5 · dbt-duckdb 1.11.0 · DuckDB 1.5.6) builds the bronze, silver and gold Apache Iceberg tables and registers them in the AWS Glue Data Catalog. It runs on demand as an ECS Fargate task (prod) or with docker run on a laptop (dev). There is no schedule." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="20" y="50" width="1880" height="36" as="geometry"/></mxCell><mxCell id="aws-lap" value="Developer laptop" style="swimlane;startSize=40;fontStyle=1;fontSize=15;html=1;rounded=1;arcSize=2;fillColor=#E2E8F0;swimlaneFillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#0F172A;collapsible=0;" vertex="1" parent="1"><mxGeometry x="20" y="90" width="300" height="1060" as="geometry"/></mxCell><mxCell id="aws-lap-sub" value='&lt;span style="font-size:12px;color:#475569"&gt;Windows 11 · PowerShell · Docker Desktop · AWS CLI&lt;/span&gt;' style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;" vertex="1" parent="aws-lap"><mxGeometry x="15" y="46" width="270" height="34" as="geometry"/></mxCell><mxCell id="aws-sc1" value='&lt;b&gt;&lt;span style="font-family:Consolas,Menlo,monospace;font-size:13px"&gt;scripts/deploy_ecs.ps1&lt;/span&gt;&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#475569"&gt;create or update the CloudFormation stack (default VPC, public subnets)&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;fontSize=12;fontColor=#1F2937;" vertex="1" parent="aws-lap"><mxGeometry x="15" y="105" width="270" height="80" as="geometry"/></mxCell><mxCell id="aws-sc2" value='&lt;b&gt;&lt;span style="font-family:Consolas,Menlo,monospace;font-size:13px"&gt;scripts/push_to_ecr.ps1 | .sh&lt;/span&gt;&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#475569"&gt;docker build linux/amd64, push :latest to ECR&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;fontSize=12;fontColor=#1F2937;" vertex="1" parent="aws-lap"><mxGeometry x="15" y="250" width="270" height="80" as="geometry"/></mxCell><mxCell id="aws-sc3" value="&lt;b&gt;&lt;span style=&quot;font-family:Consolas,Menlo,monospace;font-size:13px&quot;&gt;scripts/run_on_ecs.ps1&lt;/span&gt;&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#475569&quot;&gt;start one run, stream its logs, return dbt's exit code&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family:Consolas,Menlo,monospace;font-size:11px&quot;&gt;-DbtArgs  -Spot  -NoWait  -Environment&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;fontSize=12;fontColor=#1F2937;" vertex="1" parent="aws-lap"><mxGeometry x="15" y="390" width="270" height="100" as="geometry"/></mxCell><mxCell id="aws-repo" value='&lt;b style="font-size:13px"&gt;Source in this repo&lt;/b&gt;&lt;br&gt;&lt;span style="font-family:Consolas,Menlo,monospace;font-size:11px"&gt;Dockerfile, requirements.txt&lt;/span&gt;&lt;br&gt;&lt;span style="font-family:Consolas,Menlo,monospace;font-size:11px"&gt;docker/entrypoint.sh&lt;/span&gt;&lt;br&gt;&lt;span style="font-family:Consolas,Menlo,monospace;font-size:11px"&gt;nyc_taxi/  (dbt project)&lt;/span&gt;&lt;br&gt;&lt;span style="font-family:Consolas,Menlo,monospace;font-size:11px"&gt;infra/ecs-stack.yaml&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#475569"&gt;image: python:3.12-slim, DuckDB extensions baked in, dbt parse at build time&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#CBD5E1;align=left;verticalAlign=top;spacingTop=6;spacingLeft=12;spacingRight=8;fontSize=12;fontColor=#1F2937;" vertex="1" parent="aws-lap"><mxGeometry x="15" y="560" width="270" height="150" as="geometry"/></mxCell><mxCell id="aws-follow" value='&lt;b style="font-size:13px"&gt;Follow the run&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#475569"&gt;log lines and the exit code in the terminal&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;fontSize=12;fontColor=#1F2937;" vertex="1" parent="aws-lap"><mxGeometry x="15" y="775" width="270" height="80" as="geometry"/></mxCell><mxCell id="aws-dev" value='&lt;b style="font-size:13px"&gt;Local dev run&lt;/b&gt;&lt;br&gt;&lt;span style="font-family:Consolas,Menlo,monospace;font-size:11px"&gt;docker run -v ~/.aws:/home/dbt/.aws:ro IMAGE build --target dev&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#475569"&gt;same image, local AWS credentials; writes dev_nyc_*_duck tables under s3://…/dev/; its purge allow-list covers dev/ only, so it can never delete prod files&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0EA5E9;align=left;verticalAlign=top;spacingTop=6;spacingLeft=12;spacingRight=8;fontSize=12;fontColor=#1F2937;dashed=1;" vertex="1" parent="aws-lap"><mxGeometry x="15" y="885" width="270" height="150" as="geometry"/></mxCell><mxCell id="aws-cloud" value="AWS Cloud" style="outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=13;fontStyle=1;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;verticalAlign=top;align=left;spacingLeft=30;dashed=0;grIcon=mxgraph.aws4.group_aws_cloud_alt;strokeColor=#232F3E;fillColor=none;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="350" y="90" width="1560" height="1060" as="geometry"/></mxCell><mxCell id="aws-region" value="Region us-east-1 (N. Virginia)" style="outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=13;fontStyle=1;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;verticalAlign=top;align=left;spacingLeft=30;dashed=1;grIcon=mxgraph.aws4.group_region;strokeColor=#00A4A6;fillColor=none;fontColor=#147EBA;" vertex="1" parent="aws-cloud"><mxGeometry x="20" y="40" width="1520" height="1000" as="geometry"/></mxCell><mxCell id="aws-cfn" value='&lt;b style="font-size:14px"&gt;AWS CloudFormation&lt;/b&gt;&lt;br&gt;&lt;span style="font-family:Consolas,Menlo,monospace;font-size:12px"&gt;stack nyc-taxi-duckdb-dbt&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#475569"&gt;from infra/ecs-stack.yaml. Creates every resource with a magenta dashed outline: ECR repo, ECS cluster, task definition, IAM roles, security group, log group.&lt;/span&gt;' style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=6;spacingRight=8;fontSize=12;fontColor=#1F2937;container=1;collapsible=0;recursiveResize=0;fillColor=#FFFFFF;spacingLeft=66;strokeColor=#E7157B;dashed=1;dashPattern=6 3;strokeWidth=1.5;" vertex="1" parent="aws-region"><mxGeometry x="30" y="40" width="320" height="130" as="geometry"/></mxCell><mxCell id="aws-cfn-ic" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudformation;fillColor=#E7157B;" vertex="1" parent="aws-cfn"><mxGeometry x="10" y="10" width="44" height="44" as="geometry"/></mxCell><mxCell id="aws-ecr" value='&lt;b style="font-size:14px"&gt;Amazon ECR&lt;/b&gt;&lt;br&gt;&lt;span style="font-family:Consolas,Menlo,monospace;font-size:12px"&gt;nyc-taxi-duckdb-dbt:latest&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#475569"&gt;linux/amd64 · scan on push · lifecycle keeps the 10 newest images&lt;/span&gt;' style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=6;spacingRight=8;fontSize=12;fontColor=#1F2937;container=1;collapsible=0;recursiveResize=0;fillColor=#FFFFFF;spacingLeft=66;strokeColor=#E7157B;dashed=1;dashPattern=6 3;strokeWidth=1.5;" vertex="1" parent="aws-region"><mxGeometry x="30" y="195" width="320" height="110" as="geometry"/></mxCell><mxCell id="aws-ecr-ic" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.ecr;fillColor=#ED7100;" vertex="1" parent="aws-ecr"><mxGeometry x="10" y="10" width="44" height="44" as="geometry"/></mxCell><mxCell id="aws-ecs" value='&lt;b style="font-size:14px"&gt;Amazon ECS&lt;/b&gt;&lt;br&gt;&lt;span style="font-family:Consolas,Menlo,monospace;font-size:12px"&gt;cluster nyc-taxi-duckdb-dbt&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#475569"&gt;FARGATE + FARGATE_SPOT · no schedule: tasks start only through RunTask&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#475569"&gt;task definition: 4 vCPU · 16 GB · x86_64 · awsvpc · one container, dbt&lt;/span&gt;' style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=6;spacingRight=8;fontSize=12;fontColor=#1F2937;container=1;collapsible=0;recursiveResize=0;fillColor=#FFFFFF;spacingLeft=66;strokeColor=#E7157B;dashed=1;dashPattern=6 3;strokeWidth=1.5;" vertex="1" parent="aws-region"><mxGeometry x="30" y="330" width="320" height="140" as="geometry"/></mxCell><mxCell id="aws-ecs-ic" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.ecs;fillColor=#ED7100;" vertex="1" parent="aws-ecs"><mxGeometry x="10" y="10" width="44" height="44" as="geometry"/></mxCell><mxCell id="aws-iam" value='&lt;b style="font-size:14px"&gt;IAM roles&lt;/b&gt;&lt;br&gt;&lt;span style="font-family:Consolas,Menlo,monospace;font-size:12px"&gt;nyc-taxi-duckdb-dbt-task&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#475569"&gt;read landing/ · read and write bronze-duck/, silver-duck/, gold-duck/ · read the Glue catalog · create, update, delete tables only in nyc_*_duck&lt;/span&gt;&lt;br&gt;&lt;span style="font-family:Consolas,Menlo,monospace;font-size:12px"&gt;nyc-taxi-duckdb-dbt-execution&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#475569"&gt;pull the image from ECR, write logs&lt;/span&gt;' style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=6;spacingRight=8;fontSize=12;fontColor=#1F2937;container=1;collapsible=0;recursiveResize=0;fillColor=#FFFFFF;spacingLeft=66;strokeColor=#E7157B;dashed=1;dashPattern=6 3;strokeWidth=1.5;" vertex="1" parent="aws-region"><mxGeometry x="30" y="495" width="320" height="190" as="geometry"/></mxCell><mxCell id="aws-iam-ic" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.identity_and_access_management;fillColor=#DD344C;" vertex="1" parent="aws-iam"><mxGeometry x="10" y="10" width="44" height="44" as="geometry"/></mxCell><mxCell id="aws-cw" value='&lt;b style="font-size:14px"&gt;Amazon CloudWatch Logs&lt;/b&gt;&lt;br&gt;&lt;span style="font-family:Consolas,Menlo,monospace;font-size:12px"&gt;/ecs/nyc-taxi-duckdb-dbt&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#475569"&gt;one stream per run: dbt log + run_summary line (time, CPU, peak memory, network) · 30-day retention&lt;/span&gt;' style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=6;spacingRight=8;fontSize=12;fontColor=#1F2937;container=1;collapsible=0;recursiveResize=0;fillColor=#FFFFFF;spacingLeft=66;strokeColor=#E7157B;dashed=1;dashPattern=6 3;strokeWidth=1.5;" vertex="1" parent="aws-region"><mxGeometry x="30" y="710" width="320" height="130" as="geometry"/></mxCell><mxCell id="aws-cw-ic" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudwatch_2;fillColor=#E7157B;" vertex="1" parent="aws-cw"><mxGeometry x="10" y="10" width="44" height="44" as="geometry"/></mxCell><mxCell id="aws-vpc" value="Default VPC" style="outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=13;fontStyle=1;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;verticalAlign=top;align=left;spacingLeft=30;dashed=0;grIcon=mxgraph.aws4.group_vpc2;strokeColor=#8C4FFF;fillColor=none;fontColor=#6B46C1;" vertex="1" parent="aws-region"><mxGeometry x="400" y="80" width="560" height="797" as="geometry"/></mxCell><mxCell id="aws-subnet" value="Public subnet · task gets a public IP, no NAT gateway" style="outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=13;fontStyle=0;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;verticalAlign=top;align=left;spacingLeft=30;dashed=0;grIcon=mxgraph.aws4.group_security_group;grStroke=0;strokeColor=#7AA116;fillColor=#F2F6E8;fontColor=#248814;" vertex="1" parent="aws-vpc"><mxGeometry x="20" y="40" width="520" height="742" as="geometry"/></mxCell><mxCell id="aws-sg" value="Security group nyc-taxi-duckdb-dbt-task · outbound only, no inbound rules" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#DD3522;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontColor=#B91C1C;fontSize=12;container=1;collapsible=0;recursiveResize=0;pointerEvents=0;" vertex="1" parent="aws-subnet"><mxGeometry x="15" y="40" width="490" height="687" as="geometry"/></mxCell><mxCell id="aws-task" value='&lt;b style="font-size:14px"&gt;AWS Fargate task&lt;/b&gt; &amp;nbsp;&lt;span style="font-size:12px;color:#475569"&gt;4 vCPU · 16 GB · on demand or Spot&lt;/span&gt;' style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FFF4E8;strokeColor=#ED7100;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=52;spacingTop=10;fontSize=12;fontColor=#1F2937;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="aws-sg"><mxGeometry x="15" y="35" width="460" height="637" as="geometry"/></mxCell><mxCell id="aws-task-ic" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.fargate;fillColor=#ED7100;" vertex="1" parent="aws-task"><mxGeometry x="10" y="8" width="34" height="34" as="geometry"/></mxCell><mxCell id="aws-ctr" value='&lt;b style="font-size:13px"&gt;container dbt&lt;/b&gt; &amp;nbsp;&lt;span style="font-size:11px;color:#475569"&gt;image from ECR · ENTRYPOINT entrypoint.sh · CMD build&lt;/span&gt;' style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#F59E0B;dashed=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=12;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="aws-task"><mxGeometry x="15" y="50" width="430" height="572" as="geometry"/></mxCell><mxCell id="aws-r0" value='&lt;b&gt;&lt;span style="font-family:Consolas,Menlo,monospace;font-size:12px"&gt;entrypoint.sh&lt;/span&gt;&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#475569"&gt;DuckDB memory cap = 60% of task memory (from ECS metadata) · samples CPU, memory, network · prints run_summary&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#ED7100;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=8;fontSize=12;fontColor=#1F2937;shadow=0;strokeWidth=1;" vertex="1" parent="aws-ctr"><mxGeometry x="15" y="40" width="400" height="66" as="geometry"/></mxCell><mxCell id="aws-r0-bar" value="" style="rounded=0;fillColor=#ED7100;strokeColor=none;" vertex="1" parent="aws-ctr"><mxGeometry x="15" y="46" width="4" height="54" as="geometry"/></mxCell><mxCell id="aws-r1" value='&lt;b&gt;&lt;span style="font-family:Consolas,Menlo,monospace;font-size:12px"&gt;dbt-core 1.12.5 + dbt-duckdb 1.11.0&lt;/span&gt;&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#475569"&gt;dbt build: 11 models + 48 tests · custom iceberg_table and iceberg_incremental materializations&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FF694B;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=8;fontSize=12;fontColor=#1F2937;shadow=0;strokeWidth=1;" vertex="1" parent="aws-ctr"><mxGeometry x="15" y="114" width="400" height="66" as="geometry"/></mxCell><mxCell id="aws-r1-bar" value="" style="rounded=0;fillColor=#FF694B;strokeColor=none;" vertex="1" parent="aws-ctr"><mxGeometry x="15" y="120" width="4" height="54" as="geometry"/></mxCell><mxCell id="aws-r2" value='&lt;b&gt;&lt;span style="font-family:Consolas,Menlo,monospace;font-size:12px"&gt;DuckDB 1.5.6&lt;/span&gt;&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#475569"&gt;httpfs, aws, iceberg, avro extensions baked in · ATTACH Glue as lakehouse (TYPE iceberg, ENDPOINT_TYPE glue)&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9A400;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=8;fontSize=12;fontColor=#1F2937;shadow=0;strokeWidth=1;" vertex="1" parent="aws-ctr"><mxGeometry x="15" y="188" width="400" height="66" as="geometry"/></mxCell><mxCell id="aws-r2-bar" value="" style="rounded=0;fillColor=#C9A400;strokeColor=none;" vertex="1" parent="aws-ctr"><mxGeometry x="15" y="194" width="4" height="54" as="geometry"/></mxCell><mxCell id="aws-r3" value='&lt;b&gt;&lt;span style="font-family:Consolas,Menlo,monospace;font-size:12px"&gt;credential chain&lt;/span&gt;&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#475569"&gt;S3 secret provider credential_chain → task role on ECS, ~/.aws on a laptop&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DD344C;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=8;fontSize=12;fontColor=#1F2937;shadow=0;strokeWidth=1;" vertex="1" parent="aws-ctr"><mxGeometry x="15" y="262" width="400" height="66" as="geometry"/></mxCell><mxCell id="aws-r3-bar" value="" style="rounded=0;fillColor=#DD344C;strokeColor=none;" vertex="1" parent="aws-ctr"><mxGeometry x="15" y="268" width="4" height="54" as="geometry"/></mxCell><mxCell id="aws-r4" value='&lt;b&gt;&lt;span style="font-family:Consolas,Menlo,monospace;font-size:12px"&gt;plugins/iceberg_helpers.py&lt;/span&gt;&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#475569"&gt;iceberg_purge_location(): empties a table folder on rebuild, only inside the *-duck/ prefixes&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8C4FFF;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=8;fontSize=12;fontColor=#1F2937;shadow=0;strokeWidth=1;" vertex="1" parent="aws-ctr"><mxGeometry x="15" y="336" width="400" height="66" as="geometry"/></mxCell><mxCell id="aws-r4-bar" value="" style="rounded=0;fillColor=#8C4FFF;strokeColor=none;" vertex="1" parent="aws-ctr"><mxGeometry x="15" y="342" width="4" height="54" as="geometry"/></mxCell><mxCell id="aws-r5" value='&lt;b&gt;&lt;span style="font-family:Consolas,Menlo,monospace;font-size:12px"&gt;/tmp/dbt/nyc_taxi.duckdb&lt;/span&gt;&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#475569"&gt;local scratch: staging tables for delete+insert and rebuilds; spills to /tmp above the memory cap&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=8;fontSize=12;fontColor=#1F2937;shadow=0;strokeWidth=1;" vertex="1" parent="aws-ctr"><mxGeometry x="15" y="410" width="400" height="66" as="geometry"/></mxCell><mxCell id="aws-r5-bar" value="" style="rounded=0;fillColor=#64748B;strokeColor=none;" vertex="1" parent="aws-ctr"><mxGeometry x="15" y="416" width="4" height="54" as="geometry"/></mxCell><mxCell id="aws-r6" value='&lt;b&gt;&lt;span style="font-family:Consolas,Menlo,monospace;font-size:12px"&gt;reference/*.csv&lt;/span&gt;&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#475569"&gt;TLC lookups baked into the image (zones, vendors, rate codes, payment types), read as dbt sources&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7AA116;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=8;fontSize=12;fontColor=#1F2937;shadow=0;strokeWidth=1;" vertex="1" parent="aws-ctr"><mxGeometry x="15" y="484" width="400" height="66" as="geometry"/></mxCell><mxCell id="aws-r6-bar" value="" style="rounded=0;fillColor=#7AA116;strokeColor=none;" vertex="1" parent="aws-ctr"><mxGeometry x="15" y="490" width="4" height="54" as="geometry"/></mxCell><mxCell id="aws-legend" value='&lt;b style="font-size:12px"&gt;Legend&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#475569"&gt;&lt;span style="color:#E7157B"&gt;▭ magenta dashed outline&lt;/span&gt; = created by the stack nyc-taxi-duckdb-dbt · solid arrow = control or data flow · dashed arrow = credentials, logs, catalog pointer · S3 data and Glue databases are not in the stack: delete-stack keeps them&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;spacingRight=8;" vertex="1" parent="aws-region"><mxGeometry x="1010" y="30" width="480" height="76" as="geometry"/></mxCell><mxCell id="aws-s3" value='&lt;b style="font-size:14px"&gt;Amazon S3&lt;/b&gt;&lt;br&gt;&lt;span style="font-family:Consolas,Menlo,monospace;font-size:12px"&gt;bucket nyc-test-iceberg&lt;/span&gt;' style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=6;spacingRight=8;fontSize=12;fontColor=#1F2937;container=1;collapsible=0;recursiveResize=0;fillColor=#FFFFFF;spacingLeft=66;strokeColor=#CBD5E1;" vertex="1" parent="aws-region"><mxGeometry x="1010" y="120" width="480" height="440" as="geometry"/></mxCell><mxCell id="aws-s3-ic" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;fillColor=#7AA116;" vertex="1" parent="aws-s3"><mxGeometry x="10" y="10" width="44" height="44" as="geometry"/></mxCell><mxCell id="aws-landing" value='&lt;b&gt;&lt;span style="font-family:Consolas,Menlo,monospace;font-size:13px"&gt;landing/yellow_taxi/&lt;/span&gt;&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#475569"&gt;raw monthly TLC Parquet · 2023: 12 files, 38.3M rows, 636 MB · read-only for the pipeline&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=8;fontSize=12;fontColor=#1F2937;strokeWidth=1.5;fillColor=#EEF2F7;strokeColor=#64748B;" vertex="1" parent="aws-s3"><mxGeometry x="20" y="70" width="440" height="64" as="geometry"/></mxCell><mxCell id="aws-bronze" value='&lt;b&gt;&lt;span style="font-family:Consolas,Menlo,monospace;font-size:13px"&gt;bronze-duck/&lt;/span&gt;&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#475569"&gt;Iceberg · nyc_bronze_duck.bronze_yellow_tripdata&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=8;fontSize=12;fontColor=#1F2937;strokeWidth=1.5;fillColor=#F6E7DA;strokeColor=#A0522D;" vertex="1" parent="aws-s3"><mxGeometry x="20" y="148" width="440" height="64" as="geometry"/></mxCell><mxCell id="aws-silver" value='&lt;b&gt;&lt;span style="font-family:Consolas,Menlo,monospace;font-size:13px"&gt;silver-duck/&lt;/span&gt;&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#475569"&gt;Iceberg · silver_yellow_trips, silver_yellow_trips_rejected&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=8;fontSize=12;fontColor=#1F2937;strokeWidth=1.5;fillColor=#ECEFF3;strokeColor=#6B7280;" vertex="1" parent="aws-s3"><mxGeometry x="20" y="226" width="440" height="64" as="geometry"/></mxCell><mxCell id="aws-gold" value='&lt;b&gt;&lt;span style="font-family:Consolas,Menlo,monospace;font-size:13px"&gt;gold-duck/&lt;/span&gt;&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#475569"&gt;Iceberg · 2 fact tables + 6 dimensions (star schema)&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=8;fontSize=12;fontColor=#1F2937;strokeWidth=1.5;fillColor=#FBF1CF;strokeColor=#B8860B;" vertex="1" parent="aws-s3"><mxGeometry x="20" y="304" width="440" height="64" as="geometry"/></mxCell><mxCell id="aws-devf" value='&lt;b&gt;&lt;span style="font-family:Consolas,Menlo,monospace;font-size:12px"&gt;dev/&lt;/span&gt;&lt;/b&gt; &lt;span style="font-size:11px;color:#475569"&gt;bronze-duck/ · silver-duck/ · gold-duck/ for --target dev&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=8;fontSize=12;fontColor=#1F2937;strokeWidth=1;fillColor=#F0F9FF;strokeColor=#0EA5E9;dashed=1;" vertex="1" parent="aws-s3"><mxGeometry x="20" y="382" width="440" height="40" as="geometry"/></mxCell><mxCell id="aws-glue" value='&lt;b style="font-size:14px"&gt;AWS Glue Data Catalog&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#475569"&gt;Iceberg REST endpoint · one database per layer&lt;/span&gt;&lt;br&gt;&lt;span style="font-family:Consolas,Menlo,monospace;font-size:12px"&gt;nyc_bronze_duck · nyc_silver_duck · nyc_gold_duck&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#475569"&gt;each table points at its current Iceberg metadata.json in S3 · optional table optimizers: compaction, snapshot retention, orphan-file deletion&lt;/span&gt;' style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=6;spacingRight=8;fontSize=12;fontColor=#1F2937;container=1;collapsible=0;recursiveResize=0;fillColor=#FFFFFF;spacingLeft=66;strokeColor=#CBD5E1;" vertex="1" parent="aws-region"><mxGeometry x="1010" y="620" width="480" height="125" as="geometry"/></mxCell><mxCell id="aws-glue-ic" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.glue;fillColor=#8C4FFF;" vertex="1" parent="aws-glue"><mxGeometry x="10" y="10" width="44" height="44" as="geometry"/></mxCell><mxCell id="aws-athena" value='&lt;b style="font-size:14px"&gt;Amazon Athena&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#475569"&gt;engine v3 · SQL on the Iceberg tables through the Glue catalog, for example trips and revenue by borough and month&lt;/span&gt;' style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=6;spacingRight=8;fontSize=12;fontColor=#1F2937;container=1;collapsible=0;recursiveResize=0;fillColor=#FFFFFF;spacingLeft=66;strokeColor=#CBD5E1;" vertex="1" parent="aws-region"><mxGeometry x="1010" y="860" width="480" height="80" as="geometry"/></mxCell><mxCell id="aws-athena-ic" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.athena;fillColor=#8C4FFF;" vertex="1" parent="aws-athena"><mxGeometry x="10" y="10" width="44" height="44" as="geometry"/></mxCell><mxCell id="aws-e1" v