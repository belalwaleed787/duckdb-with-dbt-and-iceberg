aws-bronze"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="aws-e6b" value="⑥ write" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=1.5;fontColor=#1F2937;fontSize=12;labelBackgroundColor=default;endArrow=block;endFill=1;endSize=6;jumpStyle=arc;jumpSize=8;exitX=1;exitY=0.287;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="aws-task" target="aws-silver"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="aws-e6c" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=1.5;fontColor=#1F2937;fontSize=12;labelBackgroundColor=default;endArrow=block;endFill=1;endSize=6;jumpStyle=arc;jumpSize=8;exitX=1;exitY=0.41;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="aws-task" target="aws-gold"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="aws-e7" value="⑦ commit" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=1.5;fontColor=#1F2937;fontSize=12;labelBackgroundColor=default;endArrow=block;endFill=1;endSize=6;jumpStyle=arc;jumpSize=8;exitX=1;exitY=0.765;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="aws-task" target="aws-glue"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="aws-e7b" value="table → metadata.json" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#64748B;strokeWidth=1.5;fontColor=#1F2937;fontSize=12;labelBackgroundColor=default;endArrow=block;endFill=1;endSize=6;jumpStyle=arc;jumpSize=8;dashed=1;dashPattern=6 4;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="aws-glue" target="aws-s3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="aws-e10" value="⑩ SQL" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=1.5;fontColor=#1F2937;fontSize=12;labelBackgroundColor=default;endArrow=block;endFill=1;endSize=6;jumpStyle=arc;jumpSize=8;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="aws-athena" target="aws-glue"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="aws-steps" value="&lt;b&gt;Steps&lt;/b&gt; &amp;nbsp; ① deploy the stack &amp;nbsp; ② build and push the image &amp;nbsp; ③ start a run (RunTask) &amp;nbsp; ④ pull the image &amp;nbsp; ⑤ read new or re-delivered landing files &amp;nbsp; ⑥ write Parquet data + Iceberg metadata &amp;nbsp; ⑦ commit the snapshot in Glue &amp;nbsp; ⑧ send logs &amp;nbsp; ⑨ stream logs, return the exit code &amp;nbsp; ⑩ query" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="20" y="1165" width="1890" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="lineage" name="2 · dbt lineage"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1060" math="0" shadow="0" adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="lineage-title" value="dbt model lineage: landing → bronze → silver → gold" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=22;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="20" y="14" width="1400" height="34" as="geometry"/></mxCell><mxCell id="lineage-sub" value="11 models and 48 tests in one &lt;b&gt;dbt build&lt;/b&gt;. Incremental models only process landing files that are new or re-delivered: bronze compares file name + S3 last-modified time, silver and gold compare (_source_file, _batch_id) with what they already loaded." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="20" y="50" width="1460" height="36" as="geometry"/></mxCell><mxCell id="lineage-src" value='&lt;b style="font-size:15px"&gt;SOURCES&lt;/b&gt;&lt;br&gt;&lt;span style="font-family:Consolas,Menlo,monospace;font-size:11px"&gt;models/sources.yml&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;read directly by DuckDB&lt;/span&gt;' style="swimlane;startSize=64;html=1;whiteSpace=wrap;rounded=1;arcSize=2;fontSize=12;fillColor=#475569;swimlaneFillColor=#F1F5F9;strokeColor=#475569;fontColor=#FFFFFF;collapsible=0;" vertex="1" parent="1"><mxGeometry x="20" y="100" width="270" height="818" as="geometry"/></mxCell><mxCell id="lineage-brz" value='&lt;b style="font-size:15px"&gt;BRONZE&lt;/b&gt;&lt;br&gt;&lt;span style="font-family:Consolas,Menlo,monospace;font-size:11px"&gt;nyc_bronze_duck&lt;/span&gt;&lt;br&gt;&lt;span style="font-family:Consolas,Menlo,monospace;font-size:11px"&gt;s3://…/bronze-duck/&lt;/span&gt;' style="swimlane;startSize=64;html=1;whiteSpace=wrap;rounded=1;arcSize=2;fontSize=12;fillColor=#A0522D;swimlaneFillColor=#FBF3EC;strokeColor=#A0522D;fontColor=#FFFFFF;collapsible=0;" vertex="1" parent="1"><mxGeometry x="320" y="100" width="270" height="818" as="geometry"/></mxCell><mxCell id="lineage-slv" value='&lt;b style="font-size:15px"&gt;SILVER&lt;/b&gt;&lt;br&gt;&lt;span style="font-family:Consolas,Menlo,monospace;font-size:11px"&gt;nyc_silver_duck&lt;/span&gt;&lt;br&gt;&lt;span style="font-family:Consolas,Menlo,monospace;font-size:11px"&gt;s3://…/silver-duck/&lt;/span&gt;' style="swimlane;startSize=64;html=1;whiteSpace=wrap;rounded=1;arcSize=2;fontSize=12;fillColor=#6B7280;swimlaneFillColor=#F5F6F8;strokeColor=#6B7280;fontColor=#FFFFFF;collapsible=0;" vertex="1" parent="1"><mxGeometry x="620" y="100" width="270" height="818" as="geometry"/></mxCell><mxCell id="lineage-gld" value='&lt;b style="font-size:15px"&gt;GOLD&lt;/b&gt;&lt;br&gt;&lt;span style="font-family:Consolas,Menlo,monospace;font-size:11px"&gt;nyc_gold_duck&lt;/span&gt;&lt;br&gt;&lt;span style="font-family:Consolas,Menlo,monospace;font-size:11px"&gt;s3://…/gold-duck/&lt;/span&gt;' style="swimlane;startSize=64;html=1;whiteSpace=wrap;rounded=1;arcSize=2;fontSize=12;fillColor=#B8860B;swimlaneFillColor=#FDF8E8;strokeColor=#B8860B;fontColor=#FFFFFF;collapsible=0;" vertex="1" parent="1"><mxGeometry x="920" y="100" width="560" height="818" as="geometry"/></mxCell><mxCell id="lineage-landing" value='&lt;b&gt;&lt;span style="font-family:Consolas,Menlo,monospace;font-size:12px"&gt;landing.yellow_tripdata&lt;/span&gt;&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#475569"&gt;s3://nyc-test-iceberg/landing/&lt;br&gt;yellow_taxi/*.parquet · 12 files&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=6;fontSize=12;fontColor=#1F2937;fillColor=#EEF7E4;strokeColor=#7AA116;strokeWidth=1.5;" vertex="1" parent="lineage-src"><mxGeometry x="20" y="84" width="230" height="80" as="geometry"/></mxCell><mxCell id="lineage-c_vendor" value='&lt;b&gt;&lt;span style="font-family:Consolas,Menlo,monospace;font-size:12px"&gt;reference.vendors&lt;/span&gt;&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#475569"&gt;reference/vendors.csv (in the image)&lt;/span&gt;' style="shape=note;size=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=6;fontSize=12;fontColor=#1F2937;fillColor=#FFFFFF;strokeColor=#94A3B8;" vertex="1" parent="lineage-src"><mxGeometry x="20" y="399" width="230" height="80" as="geometry"/></mxCell><mxCell id="lineage-c_rate" value='&lt;b&gt;&lt;span style="font-family:Consolas,Menlo,monospace;font-size:12px"&gt;reference.rate_codes&lt;/span&gt;&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#475569"&gt;reference/rate_codes.csv (in the image)&lt;/span&gt;' style="shape=note;size=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=6;fontSize=12;fontColor=#1F2937;fillColor=#FFFFFF;strokeColor=#94A3B8;" vertex="1" parent="lineage-src"><mxGeometry x="20" y="504" width="230" height="80" as="geometry"/></mxCell><mxCell id="lineage-c_pay" value='&lt;b&gt;&lt;span style="font-family:Consolas,Menlo,monospace;font-size:12px"&gt;reference.payment_types&lt;/span&gt;&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#475569"&gt;reference/payment_types.csv (in the image)&lt;/span&gt;' style="shape=note;size=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=6;fontSize=12;fontColor=#1F2937;fillColor=#FFFFFF;strokeColor=#94A3B8;" vertex="1" parent="lineage-src"><mxGeometry x="20" y="609" width="230" height="80" as="geometry"/></mxCell><mxCell id="lineage-c_zone" value='&lt;b&gt;&lt;span style="font-family:Consolas,Menlo,monospace;font-size:12px"&gt;reference.taxi_zone_lookup&lt;/span&gt;&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#475569"&gt;reference/taxi_zone_lookup.csv (in the image)&lt;/span&gt;' style="shape=note;size=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=6;fontSize=12;fontColor=#1F2937;fillColor=#FFFFFF;strokeColor=#94A3B8;" vertex="1" parent="lineage-src"><mxGeometry x="20" y="714" width="230" height="80" as="geometry"/></mxCell><mxCell id="lineage-refnote" value='&lt;span style="font-size:11px;color:#475569"&gt;Lookup CSVs from the TLC data dictionary. Being dbt sources (not seeds), any model builds on its own without dbt seed.&lt;/span&gt;' style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="lineage-src"><mxGeometry x="20" y="199" width="230" height="110" as="geometry"/></mxCell><mxCell id="lineage-bronze" value='&lt;b&gt;&lt;span style="font-family:Consolas,Menlo,monospace;font-size:12px"&gt;bronze_yellow_tripdata&lt;/span&gt;&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#A0522D;font-weight:bold"&gt;iceberg_incremental&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#475569"&gt;landing rows as-is + _source_file, _batch_id, … · partitioned by _source_period · 38.3M rows&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=6;fontSize=12;fontColor=#1F2937;fillColor=#F6E7DA;strokeColor=#A0522D;strokeWidth=2.5;" vertex="1" parent="lineage-brz"><mxGeometry x="20" y="84" width="230" height="80" as="geometry"/></mxCell><mxCell id="lineage-bznote" value='&lt;span style="font-size:11px;color:#475569"&gt;delete+insert keyed on &lt;b&gt;_source_file&lt;/b&gt;: a re-delivered landing file replaces its rows in bronze, then in silver and fact_trips.&lt;/span&gt;' style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="lineage-brz"><mxGeometry x="20" y="199" width="230" height="90" as="geometry"/></mxCell><mxCell id="lineage-silver" value='&lt;b&gt;&lt;span style="font-family:Consolas,Menlo,monospace;font-size:12px"&gt;silver_yellow_trips&lt;/span&gt;&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#6B7280;font-weight:bold"&gt;iceberg_incremental&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#475569"&gt;typed, snake_case, de-duplicated · partitioned by month(pickup_at) · 37.0M rows&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=6;fontSize=12;fontColor=#1F2937;fillColor=#ECEFF3;strokeColor=#6B7280;strokeWidth=2.5;" vertex="1" parent="lineage-slv"><mxGeometry x="20" y="84" width="230" height="80" as="geometry"/></mxCell><mxCell id="lineage-rejected" value='&lt;b&gt;&lt;span style="font-family:Consolas,Menlo,monospace;font-size:12px"&gt;silver_yellow_trips_rejected&lt;/span&gt;&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#6B7280;font-weight:bold"&gt;iceberg_incremental&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#475569"&gt;rows that broke a rule + _reject_reason · 1.27M rows&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=6;fontSize=12;fontColor=#1F2937;fillColor=#ECEFF3;strokeColor=#6B7280;strokeWidth=2.5;" vertex="1" parent="lineage-slv"><mxGeometry x="20" y="189" width="230" height="80" as="geometry"/></mxCell><mxCell id="lineage-slnote" value='&lt;span style="font-size:11px;color:#475569"&gt;classify_yellow_trips(): first broken rule wins: duplicate, missing_timestamp, pickup_outside_file_month, invalid_duration, invalid_distance, implausible_speed, invalid_amount, unknown_location (thresholds are dbt vars)&lt;/span&gt;' style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="lineage-slv"><mxGeometry x="20" y="304" width="230" height="120" as="geometry"/></mxCell><mxCell id="lineage-fact" value='&lt;b&gt;&lt;span style="font-family:Consolas,Menlo,monospace;font-size:12px"&gt;fact_trips&lt;/span&gt;&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#B8860B;font-weight:bold"&gt;iceberg_incremental&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#475569"&gt;one row per trip, keys to every dimension · partitioned by month(pickup_at)&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=6;fontSize=12;fontColor=#1F2937;fillColor=#FBF1CF;strokeColor=#B8860B;strokeWidth=2.5;" vertex="1" parent="lineage-gld"><mxGeometry x="20" y="84" width="230" height="80" as="geometry"/></mxCell><mxCell id="lineage-daily" value='&lt;b&gt;&lt;span style="font-family:Consolas,Menlo,monospace;font-size:12px"&gt;fact_daily_zone_summary&lt;/span&gt;&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#B8860B;font-weight:bold"&gt;iceberg_table&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#475569"&gt;pickup day × pickup zone: trips, revenue, averages&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=6;fontSize=12;fontColor=#1F2937;fillColor=#FBF1CF;strokeColor=#B8860B;strokeWidth=1;" vertex="1" parent="lineage-gld"><mxGeometry x="310" y="84" width="230" height="80" as="geometry"/></mxCell><mxCell id="lineage-d_date" value='&lt;b&gt;&lt;span style="font-family:Consolas,Menlo,monospace;font-size:12px"&gt;dim_date&lt;/span&gt;&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#B8860B;font-weight:bold"&gt;iceberg_table&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#475569"&gt;one row per day of every year with trips&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=6;fontSize=12;fontColor=#1F2937;fillColor=#FBF1CF;strokeColor=#B8860B;strokeWidth=1;" vertex="1" parent="lineage-gld"><mxGeometry x="20" y="189" width="230" height="80" as="geometry"/></mxCell><mxCell id="lineage-d_time" value='&lt;b&gt;&lt;span style="font-family:Consolas,Menlo,monospace;font-size:12px"&gt;dim_time_of_day&lt;/span&gt;&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#B8860B;font-weight:bold"&gt;iceberg_table&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#475569"&gt;generated: 24 hours, day part, rush-hour flag&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=6;fontSize=12;fontColor=#1F2937;fillColor=#FBF1CF;strokeColor=#B8860B;strokeWidth=1;" vertex="1" parent="lineage-gld"><mxGeometry x="20" y="294" width="230" height="80" as="geometry"/></mxCell><mxCell id="lineage-d_vendor" value='&lt;b&gt;&lt;span style="font-family:Consolas,Menlo,monospace;font-size:12px"&gt;dim_vendor&lt;/span&gt;&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#B8860B;font-weight:bold"&gt;iceberg_table&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#475569"&gt;TLC codes + any unknown code seen in silver&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=6;fontSize=12;fontColor=#1F2937;fillColor=#FBF1CF;strokeColor=#B8860B;strokeWidth=1;" vertex="1" parent="lineage-gld"><mxGeometry x="20" y="399" width="230" height="80" as="geometry"/></mxCell><mxCell id="lineage-d_rate" value='&lt;b&gt;&lt;span style="font-family:Consolas,Menlo,monospace;font-size:12px"&gt;dim_rate_code&lt;/span&gt;&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#B8860B;font-weight:bold"&gt;iceberg_table&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#475569"&gt;TLC codes + any unknown code seen in silver&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=6;fontSize=12;fontColor=#1F2937;fillColor=#FBF1CF;strokeColor=#B8860B;strokeWidth=1;" vertex="1" parent="lineage-gld"><mxGeometry x="20" y="504" width="230" height="80" as="geometry"/></mxCell><mxCell id="lineage-d_pay" value='&lt;b&gt;&lt;span style="font-family:Consolas,Menlo,monospace;font-size:12px"&gt;dim_payment_type&lt;/span&gt;&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#B8860B;font-weight:bold"&gt;iceberg_table&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#475569"&gt;TLC codes + any unknown code seen in silver&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=6;fontSize=12;fontColor=#1F2937;fillColor=#FBF1CF;strokeColor=#B8860B;strokeWidth=1;" vertex="1" parent="lineage-gld"><mxGeometry x="20" y="609" width="230" height="80" as="geometry"/></mxCell><mxCell id="lineage-d_loc" value='&lt;b&gt;&lt;span style="font-family:Consolas,Menlo,monospace;font-size:12px"&gt;dim_location&lt;/span&gt;&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#B8860B;font-weight:bold"&gt;iceberg_table&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#475569"&gt;265 TLC taxi zones · is_airport&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=6;fontSize=12;fontColor=#1F2937;fillColor=#FBF1CF;strokeColor=#B8860B;strokeWidth=1;" vertex="1" parent="lineage-gld"><mxGeometry x="20" y="714" width="230" height="80" as="geometry"/></mxCell><mxCell id="lineage-gnote" value='&lt;b style="font-size:12px"&gt;Gold rebuild rules&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#475569"&gt;fact_trips only takes the source files whose silver batch it has not seen. The dimensions and fact_daily_zone_summary are recomputed every run with DELETE + INSERT in one transaction, so readers never see an empty table.&lt;br&gt;&lt;br&gt;Every fact key has a dbt &lt;b&gt;relationships&lt;/b&gt; test to its dimension (see page 3).&lt;/span&gt;' style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#FFF8DB;strokeColor=#D6B656;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=10;fontSize=12;fontColor=#1F2937;" vertex="1" parent="lineage-gld"><mxGeometry x="310" y="199" width="230" height="200" as="geometry"/></mxCell><mxCell id="lineage-l1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=1.5;fontColor=#1F2937;fontSize=12;labelBackgroundColor=default;endArrow=block;endFill=1;endSize=6;jumpStyle=arc;jumpSize=8;" edge="1" parent="1" source="lineage-landing" target="lineage-bronze"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="lineage-l2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=1.5;fontColor=#1F2937;fontSize=12;labelBackgroundColor=default;endArrow=block;endFill=1;endSize=6;jumpStyle=arc;jumpSize=8;" edge="1" parent="1" source="lineage-bronze" target="lineage-silver"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="lineage-l3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=1.5;fontColor=#1F2937;fontSize=12;labelBackgroundColor=default;endArrow=block;endFill=1;endSize=6;jum